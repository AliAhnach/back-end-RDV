# =============================================================
# RDV Backend — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs
# NE PAS committer .env dans git
# =============================================================

# ── Développement local ───────────────────────────────────────
SECRET_KEY=dev-secret-key-local-change-me
FLASK_DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:5501,http://127.0.0.1:5500,http://127.0.0.1:5501,http://127.0.0.1:3000

# SQLite : chemin absolu vers le fichier de base de données
# Si non défini, le fichier rdv.db est créé dans le dossier du projet
# SQLITE_PATH=/chemin/absolu/vers/rdv.db

# ── Production PythonAnywhere ─────────────────────────────────
# SECRET_KEY=<valeur-longue-aleatoire-generee-avec-secrets.token_hex(32)>
# FLASK_DEBUG=false
# CORS_ORIGINS=https://votre-site.netlify.app
# SQLITE_PATH=/home/VOTRE_USERNAME/backend/rdv.db
